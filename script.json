const games = [
  { name: "Chat qui saute", id: "10128407" },
  { name: "Maze Game", id: "19298766" },
  { name: "Pong", id: "10015059" }
];

const selector = document.getElementById("gameSelector");
const frame = document.getElementById("gameFrame");

function loadGame(id) {
  const embedURL = `https://turbowarp.org/${id}/embed?fps=60&turbo&full-screen`;
  frame.src = embedURL;
}

// Ajouter les options
games.forEach(game => {
  const option = document.createElement("option");
  option.value = game.id;
  option.textContent = game.name;
  selector.appendChild(option);
});

selector.addEventListener("change", e => {
  loadGame(e.target.value);
});

// Charger le premier jeu par défaut
loadGame(games[0].id);
